<plant>
    <seed name="true" subType="0">
        <parameter name="delayDefinition" value="0"/>
        <!--method implemented to evaluate root lateral growth delay (0: distance based, 1: delay based defined by parent organ)-->
        <parameter name="delayDefinitionShoot" value="0"/>
        <!--method implemented to evaluate shoot lateral growth delay (0: distance based, 1: delay based defined by parent organ)-->
        <parameter name="maxTil" value="0"/>
        <!--Maximal number of tillers [1]-->
        <parameter name="a" value="0.1"/>
        <!--radius [cm]-->
        <parameter name="delayB" value="3"/>
        <!--Time delay between the basal roots [day]-->
        <parameter name="delayRC" value="1000"/>
        <!--Delay between the root crowns [day]-->
        <parameter name="delaySB" value="1000"/>
        <!--Time delay between the shoot borne roots [day]-->
        <parameter name="delayTil" value="1e+09"/>
        <!--Time delay between the tillers [day]-->
        <parameter name="dx" value="0.25"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="firstB" value="1e+09"/>
        <!--Emergence of first basal root [day] (disabled: taproot only)-->
        <parameter name="firstSB" value="1e+09"/>
        <!--First emergence of a shoot borne root [day] (disabled)-->
        <parameter name="firstTil" value="1e+09"/>
        <!--Emergence of first tiller [day]-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->
        <parameter name="maxB" value="0"/>
        <!--Maximal number of basal roots [1] (0 = taproot only)-->
        <parameter name="nC" value="0"/>
        <!--Maximal number of roots per root crown [1]-->
        <parameter name="nz" value="0"/>
        <!--Distance between the root crowns along the shoot [cm]-->
        <parameter name="seedPos.x" value="0"/>
        <!--X-Coordinate of seed position [cm]-->
        <parameter name="seedPos.y" value="0"/>
        <!--Y-Coordinate of seed position [cm]-->
        <parameter name="seedPos.z" value="-0.30000001"/>
        <!--Z-Coordinate of seed position [cm]-->
        <parameter name="simulationTime" value="240"/>
        <!--Recommended final simulation time  [day]-->
    </seed>
    <root name="taproot" subType="1">
        <parameter name="gf" value="3"/>
        <!--Growth function number [1]-->
        <parameter name="tropismT" value="1"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        <parameter name="a" value="0.050000001"/>
        <!--radius [cm]-->
        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (finer segments for linking nodes)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hairsElongation" value="0"/>
        <!--Zone behind the tip without root hairs  [cm]-->
        <parameter name="hairsLength" value="0"/>
        <!--Root hair length [cm]-->
        <parameter name="hairsZone" value="0"/>
        <!--Length of the root hair zone [cm]-->
        <parameter name="la" value="12"/>
        <!--Apical zone [cm]: laterals only on basal part of taproot-->
        <parameter name="lb" value="0.3"/>
        <!--Basal zone [cm]-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral root emergence delay [day]-->
        <parameter name="lmax" value="60"/>
        <!--Maximal root length [cm]-->
        <parameter name="ln" value="1"/>
        <!--Inter-lateral distance [cm] along taproot base-->
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        <parameter name="r" value="2.4000001"/>
        <!--Initial growth rate [cm day-1]-->
        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->
        <parameter name="theta" value="0"/>
        <!--Angle between root and parent root [rad] (vertical taproot)-->
        <parameter name="tropismN" value="0.5"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="0.05"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
        <parameter name="successor" ruleId="0" numLat="1" where="1,2,3,4,5,6,7,8" subType="2" organType="2" percentage="1"/>
        <!--Exactly 8 laterals at linking nodes 1-8 near taproot base-->
    </root>
    <root name="lateral1" subType="2">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1] (linear: reaches lmax within sim time)-->
        <parameter name="tropismT" value="0"/>
        <!--Plagiotropic: keep initial heading (45 deg from parent)-->
        <parameter name="a" value="0.02"/>
        <!--radius [cm]-->
        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hairsElongation" value="0"/>
        <!--Zone behind the tip without root hairs  [cm]-->
        <parameter name="hairsLength" value="0"/>
        <!--Root hair length [cm]-->
        <parameter name="hairsZone" value="0"/>
        <!--Length of the root hair zone [cm]-->
        <parameter name="la" value="0.1"/>
        <!--Apical zone [cm] (small so all laterals reach lmax)-->
        <parameter name="lb" value="0"/>
        <!--Basal zone [cm]-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral root emergence delay [day]-->
        <parameter name="lmax" value="10"/>
        <!--Maximal root length [cm] (identical for all first-order laterals)-->
        <parameter name="lmaxs" value="0"/>
        <!--Standard deviation of maximal root length [cm]-->
        <parameter name="ln" value="1e+09"/>
        <!--No second-order laterals-->
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        <parameter name="r" value="2"/>
        <!--Initial growth rate [cm day-1]-->
        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->
        <parameter name="theta" value="0.78539816"/>
        <!--45 deg from parent [rad]-->
        <parameter name="tropismN" value="0"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="0"/>
        <!--No bending after emergence-->
    </root>
    <root name="lateral2" subType="3">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        <parameter name="tropismT" value="0"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        <parameter name="a" value="0.02"/>
        <!--radius [cm]-->
        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        <parameter name="hairsElongation" value="0"/>
        <!--Zone behind the tip without root hairs  [cm]-->
        <parameter name="hairsLength" value="0"/>
        <!--Root hair length [cm]-->
        <parameter name="hairsZone" value="0"/>
        <!--Length of the root hair zone [cm]-->
        <parameter name="la" value="0.1"/>
        <!--Apical zone [cm]-->
        <parameter name="lb" value="0"/>
        <!--Basal zone [cm]-->
        <parameter name="ldelay" value="-1"/>
        <!--Lateral root emergence delay [day]-->
        <parameter name="lmax" value="10"/>
        <!--Maximal root length [cm] (same as lateral1)-->
        <parameter name="lmaxs" value="0"/>
        <!--Standard deviation of maximal root length [cm]-->
        <parameter name="ln" value="1e+09"/>
        <!--No branching (unused while taproot only creates subType 2)-->
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        <parameter name="r" value="0.60000002"/>
        <!--Initial growth rate [cm day-1]-->
        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->
        <parameter name="theta" value="0.78539816"/>
        <!--45 deg from parent [rad]-->
        <parameter name="tropismN" value="0"/>
        <!--Number of trials of root tropism-->
        <parameter name="tropismS" value="0"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
    </root>
</plant>
