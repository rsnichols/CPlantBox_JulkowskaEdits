        <parameter name="lmaxs" value="0"/>
        <parameter name="ln" value="1"/>
        <parameter name="lnk" value="0"/>
        <parameter name="r" value="2"/>
        <parameter name="rlt" value="1e+09"/>
        <parameter name="theta" value="0.78539816"/>
        <parameter name="tropismN" value="0"/>
        <parameter name="tropismS" value="0"/>
    </root>
</plant>
